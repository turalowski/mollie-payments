# Copy to .env.local and fill in with your own values.

# Supabase — Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Mollie — use a *test mode* API key (starts with "test_") from
# https://my.mollie.com/dashboard/developers/api-keys. Server-only.
MOLLIE_API_KEY=

# Public base URL of this app, used to build Mollie redirect/webhook
# URLs. Mollie must be able to reach the webhook URL over the public
# internet, so during local development point this at a tunnel
# (e.g. ngrok) rather than http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
